# Copy this file to .env and fill in your own values. Do not commit .env.
# API Gateway Invoke URL, with no trailing slash
VITE_API_URL=https://YOUR-API-ID.execute-api.eu-west-2.amazonaws.com
# Cognito app client ID (a public identifier, not a secret)
VITE_COGNITO_CLIENT_ID=YOUR_APP_CLIENT_ID
# Optional, defaults to eu-west-2
VITE_COGNITO_REGION=eu-west-2
